# CloudInvestigator — development-safe environment template.
#
# Every variable below maps 1:1 to a field parsed by
# cloud_investigator.config.load_settings; there are no others. Values are the
# offline/local-dev defaults. Copy to `.env` for local overrides (never commit
# it — only this example file is tracked).

# Postgres DSN for the ledger + checkpointer. Matches the compose `db` service
# (make up). Local dev credentials only.
DATABASE_URL=postgresql://cloudinvestigator:cloudinvestigator@localhost:5432/cloudinvestigator

# true = deterministic offline demo (recorded cassettes, no cloud credentials).
DEMO_MODE=true

# dev | qa | prod — environment label, nothing secret.
ENVIRONMENT=dev

# Directory holding runbook markdown chunks used by RAG retrieval.
RUNBOOK_DIR=runbooks

# Context budget: max evidence items minted per probe.
MAX_EVIDENCE_PER_PROBE=40

# SQL guard: per-statement timeout for read-only probes, in milliseconds.
SQL_STATEMENT_TIMEOUT_MS=5000

# SQL guard: default row limit for read-only probes.
SQL_DEFAULT_LIMIT=100

# Embedding dimension for pgvector runbook chunks.
EMBEDDING_DIM=1024
